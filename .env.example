# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here

# MCC Finder (server-only: used by the Vercel functions in api/, never exposed to the browser)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
TYPESAFE_API_KEY=your_typesafe_api_key_here
# Optional: restrict who can run lookups (emails or @domains, comma-separated)
# MCC_ALLOWED_EMAILS=you@example.com,@yourcompany.com
